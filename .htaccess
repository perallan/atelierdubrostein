# Én adresse: https uten www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://atelierdubrostein.no%{REQUEST_URI} [L,R=301]

# Tegnsett for tekstfilene
AddType text/markdown .md
AddCharset utf-8 .md .txt .xml

# Markdown-kopien skal ikke vises i søkeresultatene
<FilesMatch "\.md$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>
